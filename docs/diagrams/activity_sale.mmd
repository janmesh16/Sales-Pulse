flowchart TD
  A([Start]) --> B[Open POS Billing Screen]
  B --> C[Search or Select Product]
  C --> D{Requested Qty <= Available Stock?}
  D -- No --> E[Display Stock Warning Toast] --> C
  D -- Yes --> F[Add Item to Cart Ticket]
  F --> G{Add More Items?}
  G -- Yes --> C
  G -- No --> H[Apply Discount & Select Payment Mode]
  H --> I[Click Complete & Checkout]
  I --> J[Begin DB Transaction]
  J --> K[SELECT ... FOR UPDATE Row Locks]
  K --> L{All Items in Stock?}
  L -- No --> M[Rollback DB, Display Error] --> B
  L -- Yes --> N[Insert sales & snapshot sale_items]
  N --> O[Decrement products stock & log stock_movements]
  O --> P[Commit DB Transaction]
  P --> Q[Generate Invoice & Display Receipt]
  Q --> Z([End])
